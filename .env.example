# ============================================
# Modelo do arquivo .env  (este arquivo VAI pro Git)
# Copie para ".env" e coloque seus dados reais:
#   cp .env.example .env      (Linux/Mac)
#   copy .env.example .env    (Windows)
# O ".env" de verdade NUNCA deve ir pro Git!
# ============================================

# Dados de conexão com o banco (MySQL/MariaDB)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=loja_games
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Pasta do projeto dentro do htdocs do XAMPP
# Ex.: se está em C:\xampp\htdocs\loja-games  ->  /loja-games
# Se rodar direto na raiz do servidor, deixe vazio.
APP_BASE_URL=/loja-games

# true = mostra erros na tela (só para desenvolvimento!)
APP_DEBUG=false
